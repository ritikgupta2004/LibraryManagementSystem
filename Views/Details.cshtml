@model LMSystem.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h2>Book Details</h2>

<table class="table table-bordered">
    <tr>
        <th>Title</th>
        <td>@Model.Title</td>
    </tr>
    <tr>
        <th>Author</th>
        <td>@Model.Author</td>
    </tr>
    <tr>
        <th>ISBN</th>
        <td>@Model.ISBN</td>
    </tr>
    <tr>
        <th>Category</th>
        <td>@Model.Category</td>
    </tr>
    <tr>
        <th>Published Year</th>
        <td>@Model.PublishedYear</td>
    </tr>
    <tr>
        <th>Total Copies</th>
        <td>@Model.TotalCopies</td>
    </tr>
    <tr>
        <th>Available Copies</th>
        <td>@Model.AvailableCopies</td>
    </tr>
    <tr>
        <th>Available</th>
        <td>@(Model.IsAvailable ? "Yes" : "No")</td>
    </tr>
    <tr>
        <th>Description</th>
        <td>@Model.Description</td>
    </tr>
    <tr>
        <th>Cover Image URL</th>
        <td>@Model.CoverImageUrl</td>
    </tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>